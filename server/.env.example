PORT=3000
MONGO_URI=mongodb://localhost:27017/proximate
JWT_SECRET=change-this-to-a-long-random-string-in-production

# Firebase Cloud Messaging (push notifications to nearby users)
# Get these from Firebase Console → Project Settings → Service Accounts
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Twilio (SMS to emergency contacts)
# Get from twilio.com/console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
